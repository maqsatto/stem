# ---------------------------------------------------------------------------
# ML + STEM LAB — example environment file.
# Copy to `.env` and change every secret before exposing the app publicly:
#     cp .env.example .env
# ---------------------------------------------------------------------------

# Public port of the site (nginx -> frontend, /api proxied to backend).
APP_PORT=8080

# PostgreSQL (used by the `db` service and the backend connection string).
POSTGRES_DB=mlstem
POSTGRES_USER=mlstem
POSTGRES_PASSWORD=change-me-strong-db-password

# Backend
ENVIRONMENT=production
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:8080
MAX_UPLOAD_MB=25
DOCS_ENABLED=true
ALLOW_STUDENT_REGISTRATION=true

# Seed demo accounts + demo content on first start. The seed is idempotent:
# if any user already exists it does nothing. Set to false after the first
# start for a clean production database.
SEED_ON_START=true

# Initial accounts created by the seed (change passwords after first login).
ADMIN_EMAIL=admin@mlstem.kz
ADMIN_PASSWORD=Admin123!
DEMO_TEACHER_EMAIL=teacher@mlstem.kz
DEMO_TEACHER_PASSWORD=Teacher123!
DEMO_STUDENT_EMAIL=student@mlstem.kz
DEMO_STUDENT_PASSWORD=Student123!
